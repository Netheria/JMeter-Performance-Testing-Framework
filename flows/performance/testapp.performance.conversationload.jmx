    &quot;update_id&quot;: 997042992,&#xd;
    &quot;message&quot;: {&#xd;
        &quot;message_id&quot;: ${message_id},&#xd;
        &quot;from&quot;: {&#xd;
            &quot;id&quot;: &quot;${__groovy(vars.get(&quot;user_id_${__threadNum}&quot;))}&quot;,&#xd;
            &quot;is_bot&quot;: false,&#xd;
            &quot;first_name&quot;: &quot;${first_name}&quot;,&#xd;

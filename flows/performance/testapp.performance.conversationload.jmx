            &quot;username&quot;: &quot;${__groovy(vars.get(&quot;user_name_${__threadNum}&quot;))}&quot;,&#xd;
            &quot;type&quot;: &quot;private&quot;&#xd;
        },&#xd;
        &quot;date&quot;: ${__time(/1000,)},&#xd;
        &quot;text&quot;: &quot;${__groovy(vars.get(&quot;CSATAnswer&quot;))}&quot;&#xd;
    }&#xd;
}</stringProp>

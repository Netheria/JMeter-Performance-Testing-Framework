              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JMX - User_name and User_id for &quot;Client&quot; messages Extractor" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper;
def responseCode = null;
def responseBody = null;
try {
	responseCode = prev.getResponseCode();
	responseBody = prev.getResponseDataAsString();
} catch (groovy.json.JsonException nohttp_error) {
	SampleResult.setResponseData(&quot;Engine is down.&quot;, &quot;UTF-8&quot;);
}
if (responseCode == &quot;304&quot;) {
	//prev.setResponseData(&quot;Agent has no assigned conversations.&quot;, &quot;UTF-8&quot;);
	SampleResult.setResponseData(&quot;Agent has no assigned conversations.&quot;, &quot;UTF-8&quot;);
} else if (responseCode == &quot;502&quot;) {
	SampleResult.setResponseData(&quot;Engine is down.&quot;, &quot;UTF-8&quot;);
} else {
	// Get the JSON response as a String
	def jsonResponse = prev.getResponseDataAsString();
	
	// Parse the JSON string using JsonSlurper
	def json = new JsonSlurper().parseText(jsonResponse);
	
	// Extract the value using the JSON path expression ($ = &quot;json&quot; to start from root) or give it null value
	def user_name;
	try {
		user_name = json.data.payload[0].meta.sender.name;
		vars.put(&quot;user_name_${__threadNum}&quot;, user_name.toString());
	} catch (NullPointerException error_name) {  //
		user_name = null;
		vars.put(&quot;user_name_${__threadNum}&quot;, user_name);
	}
	def user_id;
	try {
		user_id = json.data.payload[0].additional_attributes.chatId;
		vars.put(&quot;user_id_${__threadNum}&quot;, user_id.toString());
	} catch (NullPointerException error_id) {
		user_id = null;
		vars.put(&quot;user_id_${__threadNum}&quot;, user_id);
	}
	SampleResult.setResponseData((&quot;User name: &quot; + user_name + &quot;, User ID: &quot; + user_id), &quot;UTF-8&quot;);
}</stringProp>
              </JSR223Sampler>

          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">if (${__threadNum}.toInteger() == 1) {
	def ThreadGroupName = org.apache.jmeter.threads.JMeterContextService.getContext().getThreadGroup().getName();
	props.put(&quot;ClientThreadGroupName&quot;, ThreadGroupName);

	def ActiveThreads = ctx.getThreadGroup().getNumberOfThreads();
	props.put(&quot;ClientActiveThreads&quot;, ActiveThreads);
}


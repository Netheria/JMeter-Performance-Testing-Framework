          <stringProp name="script">Integer agent_tokens = Integer.valueOf(vars.get(&quot;db_token_#&quot;));

for (int i = 1; i &lt;= agent_tokens; i++) {
    String agent_token = vars.get(&quot;db_token_&quot; + i);

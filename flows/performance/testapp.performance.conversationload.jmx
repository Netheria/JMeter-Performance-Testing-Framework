        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JMX - Get variables from properties" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">//get variables from the SetUp thread and put it into this thread
def conversationId = props.get(&quot;conversationId&quot;);
vars.put(&quot;conversationId&quot;, conversationId);

def contactId = props.get(&quot;contactId&quot;);
vars.put(&quot;contactId&quot;, contactId);

def agentToken = props.get(&quot;agent_token_${__threadNum}&quot;);
vars.put(&quot;agentToken&quot;, agentToken);

//and put them in this thread workflow
def iteration = vars.getIteration() as int;

if (iteration == 1) {
	String conv_id = conversationId.toString();
	vars.put(&quot;conv_id&quot;, conv_id);
	String cont_id = contactId.toString();
	vars.put(&quot;cont_id&quot;, cont_id);
}

SampleResult.setIgnore();</stringProp>

            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JMX - Random csat number" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Random;

Random rand = new Random();
String randomNumber = (rand.nextInt(5) + 1).toString();


if (randomNumber == &quot;1&quot;) {
String CSAT = &quot;Very bad 😩&quot;;
vars.put(&quot;CSATAnswer&quot;, CSAT);
} else if (randomNumber == &quot;2&quot;) {
String CSAT = &quot;Bad 😕&quot;;
vars.put(&quot;CSATAnswer&quot;, CSAT);
} else if (randomNumber == &quot;3&quot;) {
String CSAT = &quot;So-so 😐&quot;;
vars.put(&quot;CSATAnswer&quot;, CSAT);
} else if (randomNumber == &quot;4&quot;) {
String CSAT = &quot;Good 😊&quot;;
vars.put(&quot;CSATAnswer&quot;, CSAT);
} else if (randomNumber == &quot;5&quot;) {
String CSAT = &quot;Excellent 😄&quot;;
vars.put(&quot;CSATAnswer&quot;, CSAT);
}

SampleResult.setIgnore();</stringProp>
            </JSR223Sampler>
            <hashTree/>

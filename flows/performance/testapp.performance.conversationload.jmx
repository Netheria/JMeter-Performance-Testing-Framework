          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JMX - Agents array population" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.List;
import java.util.ArrayList;

if (vars.get(&quot;AgentList&quot;) != null) {
	List AgentList = vars.getObject(&quot;AgentList&quot;);
	AgentList.add(vars.get(&quot;userId&quot;));
} else {
	def AgentList = [&quot;1&quot;];                  //adding admin user, just in case
	vars.putObject(&quot;AgentList&quot;, AgentList); //here I add list to jmeter thread variables
	AgentList.add(vars.get(&quot;userId&quot;));
}

SampleResult.setIgnore();</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>

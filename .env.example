# JMeter Configuration
JMETER_HEAP=2g
CONCURRENT_AGENTS=5
AGENT_RAMPUP=120
CONCURRENT_CLIENTS=3
CLIENT_RAMPUP=120

# Database Configuration (external system)
DB_HOST=192.0.2.10
DB_PORT=5432
DB_USER=testapp_user
DB_PASSWORD=demo_password
DB_NAME=testapp_db

# InfluxDB Configuration
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_DB=jmeter_metrics
INFLUXDB_USER=jmeter
INFLUXDB_PASSWORD=jmeter_password
INFLUXDB_RETENTION=30d

# Test Identifiers
BUILD_TAG=local-test
COMPARE_BUILD_TAG=baseline

# Optional: Kubernetes Configuration (if testing against K8s)
KUBE_CONFIG_PATH=/opt/jmeter/resources/
KUBE_CONFIG_YAML=dev-01-test.yaml
KUBE_DOMAIN_NAME=k3s.test.example.com
KUBE_SERVER_IP=192.0.2.20
KUBE_API_AUTH_TOKEN=token-placeholder
NAMESPACE=default

# Optional: Prometheus Configuration
PROM_DOMAIN_NAME=prometheus.k3s.test.example.com
PROM_SERVER_IP=192.0.2.21
PROM_STEP=15s

# API/Integration Settings
API_ACCESS_TOKEN=demo_api_token_123456
ACCOUNT_ID=1
INBOX_ID=1
TEAM_ID=1
